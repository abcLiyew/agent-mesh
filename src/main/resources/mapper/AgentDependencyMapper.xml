<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.esdllm.agentmesh.repository.mapper.AgentDependencyMapper">

    <resultMap id="BaseResultMap" type="com.esdllm.agentmesh.model.domain.AgentDependencyEntity">
        <id property="id" column="id" />
        <result property="agentId" column="agent_id" />
        <result property="dependsOnAgentId" column="depends_on_agent_id" />
        <result property="dependencyType" column="dependency_type" />
        <result property="priority" column="priority" />
        <result property="createdBy" column="created_by" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <!-- 根据智能体 ID 查询依赖列表 -->
    <select id="selectByAgentId" resultMap="BaseResultMap">
        SELECT * FROM agent_dependency
        WHERE agent_id = #{agentId}
        ORDER BY priority ASC, created_at DESC
    </select>

    <!-- 检查依赖关系是否存在 -->
    <select id="selectByPair" resultMap="BaseResultMap">
        SELECT * FROM agent_dependency
        WHERE agent_id = #{agentId}
          AND depends_on_agent_id = #{dependsOnAgentId}
    </select>

</mapper>
